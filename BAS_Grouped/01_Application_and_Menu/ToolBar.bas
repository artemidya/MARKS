' CreateToolbar (Sub), source lines 25-34
' -----------------------------------------------------------------------------
Public Sub CreateToolbar()
    Select Case UCase(Application.name)
        Case "CORELDRAW"
            CreateToolBarForCorelDraw
        Case "CORELDESIGNER"
            MsgBox "Corel Designer???"
        Case Else
            CreateToolBarForCorelDraw
    End Select
End Sub

' -----------------------------------------------------------------------------
' CreateToolBarForCorelDraw (Sub), source lines 35-65
' -----------------------------------------------------------------------------
Private Sub CreateToolBarForCorelDraw()
    Select Case Application.VersionMajor
        Case 24 'CorelDraw 2022-2023
            CreateToolBarForCorelDrawX8
            
        Case 23 'CorelDraw 2021
            CreateToolBarForCorelDrawX8
            
        Case 22 'CorelDraw 2020
            CreateToolBarForCorelDrawX8
            
        Case 21 'CorelDraw 2019
            CreateToolBarForCorelDrawX8
            
        Case 20 'CorelDraw 2018
            CreateToolBarForCorelDrawX8
            
        Case 19 'CorelDraw 2017
            CreateToolBarForCorelDrawX8
            
        Case 18 'CorelDraw X8
            CreateToolBarForCorelDrawX8
            
        Case 17 'CorelDraw X7
            CreateToolBarForCorelDrawX7
            
        Case Else 'Corel ?
            CreateToolBarForCorelDrawX8
            
    End Select
End Sub

' -----------------------------------------------------------------------------
' CreateToolBarForCorelDrawX8 (Sub), source lines 66-94
' -----------------------------------------------------------------------------
Private Sub CreateToolBarForCorelDrawX8()
    On Error GoTo 10
    
    'Proverit versiu, esli ne sovpadaet to udalit PlotCalc ToolBar
    UserData.Load
    
    If UserData.ToolBarVersion <> CurToolBarVersion Then DeleteFilesAndToolBar
    '=============================================================================================================
    If IsPlotCalcToolBarExists = False Then
        MsgBox "Creating panel for PlotCalc", vbInformation
        Application.CommandBars.Add "PlotCalc"
        Init
        Dim q As Long
        For q = 0 To UBound(Subs)
            Application.CommandBars("PlotCalc").Controls.AddCustomButton UICategories.cdrCmdCategoryMacros, Subs(q)
        Next
        'to save cur toolbar version number
        UserData.ToolBarVersion = CurToolBarVersion
        UserData.Save
    End If
    If Application.CommandBars("PlotCalc").Visible = False Then
        Application.CommandBars("PlotCalc").Visible = True
    End If
    SetToolTipText
    SetIconsPictures
    Exit Sub
10
    MsgBox "(ошибка 002) не удается создать панель инструментов PlotCalc", vbCritical
End Sub

' -----------------------------------------------------------------------------
' CreateToolBarForCorelDrawX7 (Sub), source lines 95-123
' -----------------------------------------------------------------------------
Private Sub CreateToolBarForCorelDrawX7()
    On Error GoTo 10
    
    'Proverit versiu, esli ne sovpadaet to udalit PlotCalc ToolBar
    UserData.Load
    If UserData.ToolBarVersion <> CurToolBarVersion Then DeleteToolBar
    '=============================================================================================================
    If IsPlotCalcToolBarExists = False Then
        MsgBox "Creating panel for PlotCalc", vbInformation
        Application.CommandBars.Add "PlotCalc"
        Init
        Dim q As Long
        For q = 0 To UBound(Subs)
            Application.CommandBars("PlotCalc").Controls.AddCustomButton UICategories.cdrCmdCategoryMacros, Subs(q)
        Next
        SetIcons
        'to save cur toolbar version number
        UserData.ToolBarVersion = CurToolBarVersion
        UserData.Save
    End If
    If Application.CommandBars("PlotCalc").Visible = False Then
        Application.CommandBars("PlotCalc").Visible = True
    End If
    SetToolTipText
  Exit Sub
10
    MsgBox "(ошибка 002) не удается создать панель инструментов PlotCalc", vbCritical
    
End Sub

